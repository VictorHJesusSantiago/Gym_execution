# Copie para `.env` (git-ignorado — ver ../.gitignore) e ajuste para o seu
# ambiente. Variáveis `EXPO_PUBLIC_*` são embutidas no bundle e ficam
# visíveis no cliente — nunca colocar segredos aqui (ver authStorage.ts
# para como o token de sessão é guardado com segurança).

# URL base da API (backend/), lida em src/services/apiClient.ts.
# Em emulador Android, "localhost" do host não é acessível diretamente —
# use o IP da máquina na rede local ou o alias 10.0.2.2 (emulador Android Studio).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
