{
  "expo": {
    "name": "Gym Execution",
    "slug": "gym-execution",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymexecution.app"
    },
    "android": {
      "package": "com.gymexecution.app",
      "minSdkVersion": 23
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "O app usa a câmera para analisar sua execução do exercício em tempo real.",
          "recordAudioAndroid": false
        }
      ],
      "react-native-fast-tflite"
    ]
  }
}
