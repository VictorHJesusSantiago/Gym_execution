# Copie para `.env` (nunca commitar o `.env` real — já é git-ignorado nos
# templates usuais de Python/FastAPI) e preencha com valores locais.
# Lido por `app/core/config.py` (pydantic-settings); os valores abaixo
# são os mesmos defaults de desenvolvimento do código, só explicitados
# aqui para facilitar customização.

APP_NAME="Gym Execution API"
ENVIRONMENT=development

# Banco local (ver docker-compose ou instalação própria do Postgres).
DATABASE_URL=postgresql+psycopg2://gym:gym@localhost:5432/gym_execution
REDIS_URL=redis://localhost:6379/0

# Gerar uma chave forte e aleatória em produção, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Limita /auth/register e /auth/login por IP (ver app/core/rate_limit.py).
# Manter "true" em produção; só desligar em ambientes de teste/CI que
# disparam muitas chamadas de auth em sequência.
RATE_LIMIT_ENABLED=true

MEDIA_STORAGE_URL=https://storage.example.com

# Usada pelo pipeline de ingestão (backend/pipeline/publish_reference.py)
# para chamar PUT /exercises/{id}/reference-model — gerar com o mesmo
# comando do JWT_SECRET_KEY acima, nunca reaproveitar valores.
ADMIN_API_KEY=change-me-in-env
